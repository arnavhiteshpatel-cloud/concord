        },
        "timestamp_ns": {
          "description": "Runtime wall clock at ingest, UTC ns",
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "device_id",
        "seq",
        "timestamp_ns",
        "capability",
        "quality",
        "provenance",
        "event_type",
        "payload"
      ],
      "title": "SelectionIntentEvent",
      "type": "object"
    },
    "SelectionIntentPayload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "primary",
          "default": "primary",
          "title": "Action",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "SelectionIntentPayload",
      "type": "object"
    },
    "TelemetryMetric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "maxLength": 16,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "TelemetryMetric",
      "type": "object"
    },
    "TelemetrySampleEvent": {
      "additionalProperties": false,
      "properties": {
        "capability": {
