{
  "$defs": {
    "BehaviorSampleEvent": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "device_id": {
          "pattern": "^[a-z0-9][a-z0-9_.:\\-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "device_timestamp_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device clock from the native packet, if any",
          "title": "Device Timestamp Ns"
        },
        "event_type": {
          "const": "behavior.sample",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/BehaviorSamplePayload"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^ses_[A-Za-z0-9]{6,64}$",
          "title": "Session Id",
          "type": "string"
        },
        "timestamp_ns": {
          "description": "Runtime wall clock at ingest, UTC ns",
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "device_id",
        "seq",
        "timestamp_ns",
        "capability",
        "quality",
        "provenance",
        "event_type",
        "payload"
      ],
      "title": "BehaviorSampleEvent",
      "type": "object"
    },
    "BehaviorSamplePayload": {
      "additionalProperties": false,
      "description": "Recorded behavioral ground truth (schema 1.1). Never an intent.\n\n``valid`` is false where the dataset marks the sample as excluded from\ntraining/evaluation (e.g. FALCON ``eval_mask``).",
      "properties": {
        "dims": {
          "items": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Dims",
          "type": "array"
        },
        "quantity": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Quantity",
          "type": "string"
        },
        "sample_index": {
          "minimum": 0,
          "title": "Sample Index",
          "type": "integer"
        },
        "unit": {
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "dims",
        "unit",
        "values",
        "sample_index"
      ],
      "title": "BehaviorSamplePayload",
      "type": "object"
    },
    "Capability": {
      "enum": [
        "recording",
        "pointer_intent",
        "selection",
        "text_intent",
        "telemetry",
        "device_status",
        "neural_features",
        "behavior",
        "kinematic_intent",
        "navigation",
        "control_status"
      ],
      "title": "Capability",
      "type": "string"
    },
