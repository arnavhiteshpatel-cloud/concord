    "FeaturesVectorPayload": {
      "additionalProperties": false,
      "description": "One time bin of a continuous-valued neural feature per channel (schema 1.2).\n\nE.g. log band power. The bin ends at the envelope's ``device_timestamp_ns``.",
      "properties": {
        "band_hz": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Hz"
        },
        "bin_index": {
          "minimum": 0,
          "title": "Bin Index",
          "type": "integer"
        },
        "bin_ms": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Bin Ms",
          "type": "number"
        },
        "channel_count": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Channel Count",
          "type": "integer"
        },
        "feature": {
          "enum": [
            "band_power",
            "log_band_power",
            "spike_band_power"
          ],
          "title": "Feature",
          "type": "string"
        },
        "unit": {
          "description": "e.g. 'uV^2', 'log10(uV^2)', 'log10(arbitrary^2)'",
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "feature",
        "unit",
        "bin_ms",
        "bin_index",
        "channel_count",
        "values"
      ],
      "title": "FeaturesVectorPayload",
      "type": "object"
    },
