        "event_type",
        "payload"
      ],
      "title": "TextIntentEvent",
      "type": "object"
    },
    "TextIntentPayload": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "mode": {
          "enum": [
            "character",
            "word"
          ],
          "title": "Mode",
          "type": "string"
        },
        "text": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "mode",
        "confidence"
      ],
      "title": "TextIntentPayload",
      "type": "object"
    }
  },
  "$id": "https://brainos.local/schemas/event-envelope.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "device.status": "#/$defs/DeviceStatusEvent",
      "intent.pointer": "#/$defs/PointerIntentEvent",
      "intent.selection": "#/$defs/SelectionIntentEvent",
      "intent.text": "#/$defs/TextIntentEvent",
      "recording.annotation": "#/$defs/RecordingAnnotationEvent",
      "recording.frame": "#/$defs/RecordingFrameEvent",
      "telemetry.sample": "#/$defs/TelemetrySampleEvent"
    },
    "propertyName": "event_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RecordingFrameEvent"
    },
    {
      "$ref": "#/$defs/RecordingAnnotationEvent"
    },
    {
      "$ref": "#/$defs/PointerIntentEvent"
    },
    {
      "$ref": "#/$defs/SelectionIntentEvent"
    },
    {
      "$ref": "#/$defs/TextIntentEvent"
    },
    {
      "$ref": "#/$defs/TelemetrySampleEvent"
    },
    {
      "$ref": "#/$defs/DeviceStatusEvent"
    }
  ],
  "title": "BrainOS EventEnvelope 1.0"
}
