          "const": "intent.selection",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SelectionIntentPayload"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^ses_[A-Za-z0-9]{6,64}$",
          "title": "Session Id",
