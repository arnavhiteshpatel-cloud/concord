    "PointerIntentPayload": {
      "additionalProperties": false,
      "description": "Velocity in workspace units per second; the workspace is the unit square.",
      "properties": {
        "vx": {
          "maximum": 10,
          "minimum": -10,
          "title": "Vx",
          "type": "number"
        },
