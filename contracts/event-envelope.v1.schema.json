        "payload"
      ],
      "title": "FeaturesBinnedEvent",
      "type": "object"
    },
    "FeaturesBinnedPayload": {
      "additionalProperties": false,
      "description": "One time bin of a processed neural feature per channel (schema 1.1).\n\n``counts[c]`` is the feature value for channel ``c`` in the bin that *ends* at the\nenvelope's ``device_timestamp_ns`` and spans ``bin_ms`` before it.",
      "properties": {
        "bin_index": {
          "minimum": 0,
          "title": "Bin Index",
          "type": "integer"
        },
        "bin_ms": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Bin Ms",
          "type": "number"
        },
        "channel_count": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Channel Count",
          "type": "integer"
        },
        "counts": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Counts",
          "type": "array"
        },
        "feature": {
          "enum": [
            "threshold_crossing_count",
            "spike_count"
          ],
          "title": "Feature",
          "type": "string"
        },
        "unit": {
          "const": "count",
          "default": "count",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "feature",
        "bin_ms",
        "bin_index",
        "channel_count",
        "counts"
      ],
      "title": "FeaturesBinnedPayload",
      "type": "object"
    },
