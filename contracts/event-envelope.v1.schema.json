      ],
      "title": "ControlStateEvent",
      "type": "object"
    },
    "ControlStatePayload": {
      "additionalProperties": false,
      "description": "Runtime notice to ONE application (schema 1.4): whether decoded command output is\ncurrently delivered to it. ``active: false`` = stop acting and enter a safe state.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Capabilities",
          "type": "array"
        },
        "reason": {
          "maxLength": 256,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "active",
        "reason"
      ],
      "title": "ControlStatePayload",
      "type": "object"
    },
    "DeviceState": {
      "enum": [
        "connected",
        "streaming",
        "paused",
        "reconnecting",
        "disconnected",
        "error",
        "ended"
      ],
      "title": "DeviceState",
      "type": "string"
    },
