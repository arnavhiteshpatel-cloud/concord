        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^ses_[A-Za-z0-9]{6,64}$",
          "title": "Session Id",
          "type": "string"
        },
        "timestamp_ns": {
          "description": "Runtime wall clock at ingest, UTC ns",
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "device_id",
        "seq",
        "timestamp_ns",
        "capability",
        "quality",
        "provenance",
        "event_type",
        "payload"
      ],
      "title": "TelemetrySampleEvent",
      "type": "object"
    },
    "TelemetrySamplePayload": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "items": {
            "$ref": "#/$defs/TelemetryMetric"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "metrics"
      ],
      "title": "TelemetrySamplePayload",
      "type": "object"
    },
    "TextIntentEvent": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "device_id": {
          "pattern": "^[a-z0-9][a-z0-9_.:\\-]{0,63}$",
