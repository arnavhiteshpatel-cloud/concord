{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainos.invalid/schemas/brainos-hwval.report-1.json",
  "title": "brainos-hwval verification report (brainos-hwval.report/1)",
  "type": "object",
  "required": [
    "format", "tool", "created_at", "protocol", "result", "result_explanation",
    "required_checks_by_status", "evidence_scope", "inputs", "acquisition", "summary", "checks",
    "thresholds", "limitations", "environment"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "brainos-hwval.report/1"},
    "tool": {"type": "string", "pattern": "^brainos-hwval \\d+\\.\\d+\\.\\d+"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
    "protocol": {"enum": ["lsl", "openephys"]},
    "result": {"$ref": "#/$defs/status"},
    "result_explanation": {"type": "string"},
    "required_checks_by_status": {
      "type": "object",
      "required": ["pass", "fail", "inconclusive", "not_tested"],
      "additionalProperties": false,
      "properties": {
        "pass": {"$ref": "#/$defs/ids"},
        "fail": {"$ref": "#/$defs/ids"},
        "inconclusive": {"$ref": "#/$defs/ids"},
        "not_tested": {"$ref": "#/$defs/ids"}
      }
    },
    "evidence_scope": {
      "type": "object",
      "required": ["level", "hardware_verified", "human_validated", "statement",
                   "not_a_hardware_run_because"],
      "properties": {
        "level": {"enum": ["none", "software_acquisition_comparison", "hardware_run_candidate"]},
        "hardware_verified": {"const": false},
        "human_validated": {"const": false},
        "statement": {"type": "string"},
        "not_a_hardware_run_because": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "path", "kind", "bytes", "sha256"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"enum": ["file", "directory"]},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "acquisition": {"type": "object"},
    "summary": {"type": "object", "required": ["result"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "required", "status", "summary", "method",
                     "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "title": {"type": "string"},
          "category": {"enum": ["input", "identity", "metadata", "integrity", "timing", "source",
                                "scope"]},
          "required": {"type": "boolean"},
          "status": {"$ref": "#/$defs/status"},
          "summary": {"type": "string"},
          "method": {"type": "string"},
          "evidence": {"type": "object"}
        }
      }
    },
    "thresholds": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object", "required": ["brainos_hwval", "python", "numpy"]},
    "command": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"enum": ["pass", "fail", "inconclusive", "not_tested"]},
    "ids": {"type": "array", "items": {"type": "string"}}
  }
}
